local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local _API = "https://jmods-whitelist-api-k3mg.vercel.app/api/check"
local _TOKEN = "jmods2024secreto"

local function getHWID()
    if gethwid then return tostring(gethwid()) end
    if getdeviceid then return tostring(getdeviceid()) end
    if identifyexecutor then
        local name, ver = identifyexecutor()
        return "exec_" .. tostring(name) .. "_" .. tostring(ver or "0")
    end
    return "unknown_" .. tostring(LocalPlayer.UserId)
end

local WL = {}

--- placeId: nil = usa el juego actual automaticamente
---           189707 = solo acepta si tiene acceso a ese juego o a global
function WL:IsAllowed(placeId)
    local body = HttpService:JSONEncode({
        userId  = LocalPlayer.UserId,
        username = LocalPlayer.Name,
        hwid    = getHWID(),
        placeId = placeId or game.PlaceId,
        token   = _TOKEN
    })

    local responseBody = nil
    local req = (syn and syn.request) or http_request or request or (http and http.request)

    if req then
        local ok, res = pcall(function()
            return req({
                Url     = _API,
                Method  = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body    = body
            })
        end)
        if ok and res and res.StatusCode == 200 then
            responseBody = res.Body
        end
    end

    if not responseBody then
        local ok2, res2 = pcall(function()
            return HttpService:RequestAsync({
                Url     = _API,
                Method  = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body    = body
            })
        end)
        if ok2 and res2 and res2.StatusCode == 200 then
            responseBody = res2.Body
        end
    end

    if not responseBody then return false end
    local pok, data = pcall(HttpService.JSONDecode, HttpService, responseBody)
    if not pok or type(data) ~= "table" then return false end
    return data.allowed == true
end

return WL
