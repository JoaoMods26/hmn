local function getHWID()
    if gethwid then return tostring(gethwid()) end
    if getdeviceid then return tostring(getdeviceid()) end
    if identifyexecutor then
        local name, ver = identifyexecutor()
        return "exec_" .. tostring(name) .. "_" .. tostring(ver or "0")
    end
    return "unknown_" .. tostring(LocalPlayer.UserId)
end

local WL = {}
function WL:IsAllowed(requiredPlaceId)
    local req = (syn and syn.request) or http_request or request or (http and http.request)
    if not req then return false end
    local url = SUPA_URL .. "/rest/v1/whitelist?user_id=eq." .. tostring(LocalPlayer.UserId)
    local ok, res = pcall(function()
        return req({
            Url = url,
            Method = "GET",
            Headers = {
                ["Content-Type"] = "application/json",
                ["apikey"] = SUPA_KEY,
                ["Authorization"] = "Bearer " .. SUPA_KEY
            }
        })
    end)
    if not ok or not res or res.StatusCode ~= 200 then return false end
    local pok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
    if not pok or type(data) ~= "table" or #data == 0 then return false end
    local hwid = getHWID()
    local entry = nil
    for _, e in ipairs(data) do
        if e.place_id == 0 or tostring(e.place_id) == tostring(requiredPlaceId) then
            entry = e; break
        end
    end
    if not entry then return false end
    if entry.place_id ~= 0 and tostring(game.PlaceId) ~= tostring(entry.place_id) then return false end
    if string.lower(entry.username) ~= string.lower(LocalPlayer.Name) then return false end
    if entry.hwid ~= hwid then return false end
    if entry.banned then return false end
    if not entry.active then return false end
    if entry.expires ~= 0 and os.time() > entry.expires then return false end
    return true
end
return WL
